# ---------------------------------------------------------------------------
# Global platform settings (read by bin/platform; also passed to every stack)
# Copy to .env  ->  `bin/platform init dev|prod` does this for you.
# ---------------------------------------------------------------------------
# dev  = Windows/WSL workstation, *.mysite.test, mkcert certificates
# prod = VPS, Let's Encrypt domains and/or IP:port with private-CA certificate
PLATFORM_ENV=dev

# Stacks started by `bin/platform up` (no args) and stopped by `bin/platform down`.
# Comma separated, in start order. Names resolve to stacks/*/<name>.
PLATFORM_STACKS=traefik,portainer,mysql56

TZ=Asia/Jakarta

# Optional: Portainer API, only for `bin/platform portainer-import`
PORTAINER_URL=https://127.0.0.1:9443
PORTAINER_TOKEN=
PORTAINER_ENDPOINT_ID=1
