APP_ROOT=/app
TZ=Asia/Jakarta
MYSQL56_TAG=5.6.43
MYSQL56_CNF=low-memory
MYSQL56_BIND=127.0.0.1
MYSQL56_PORT=3306
# only used when /app/data/mysql56 is empty (first start). Dev: allow empty root password.
MYSQL56_ALLOW_EMPTY=yes
MYSQL56_ROOT_PASSWORD=
# Memory cap (default 512m matches the low-memory profile; 0 = unlimited). Proxy sidecar: MYSQL56_PROXY_MEM_LIMIT (32m).
# MYSQL56_MEM_LIMIT=512m
