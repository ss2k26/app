[mysqld]
performance_schema=OFF
max_connections=10
thread_cache_size=2
table_open_cache=64

key_buffer_size=8K
innodb_buffer_pool_size=5M
innodb_log_buffer_size=1M

query_cache_type=0
query_cache_size=0

tmp_table_size=1M
max_heap_table_size=1M
sort_buffer_size=256K
join_buffer_size=128K
read_buffer_size=128K
read_rnd_buffer_size=256K
thread_stack=192K
