APP_ROOT=/app
TZ=Asia/Jakarta
MYSQL56_TAG=5.6.43
MYSQL56_CNF=production
MYSQL56_MEM_LIMIT=2g
# 127.0.0.1 = SSH tunnel only (recommended). 0.0.0.0 = open to remote PCs: needs a strong root
# password + firewall rule (see docs/databases.md).
MYSQL56_BIND=127.0.0.1
MYSQL56_PORT=3306
MYSQL56_ROOT_PASSWORD=change-me-first-start-only
