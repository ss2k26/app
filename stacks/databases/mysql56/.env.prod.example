APP_ROOT=/app
TZ=Asia/Jakarta
MYSQL56_TAG=5.6.43
MYSQL56_CNF=production
# production.cnf: 1G buffer pool
MYSQL56_MEM_LIMIT=2g
# 127.0.0.1 = SSH tunnel only (recommended). 0.0.0.0 = open to remote PCs: needs a strong root
# password + firewall rule (see docs/databases.md).
MYSQL56_BIND=127.0.0.1
MYSQL56_PORT=3306
MYSQL56_ROOT_PASSWORD=change-me-first-start-only
# Proxy sidecar cap (default 32m): MYSQL56_PROXY_MEM_LIMIT=32m
# MYSQL56_MEM_LIMIT above: ~2x innodb_buffer_pool_size / shared_buffers. Raise buffer pool and limit together (docs/memory.md).
