APP_ROOT=/app
TZ=Asia/Jakarta
MARIADB_TAG=11.4
MARIADB_CNF=production
# production.cnf: 1G buffer pool
MARIADB_MEM_LIMIT=2g
MARIADB_BIND=127.0.0.1
MARIADB_PORT=3308
MARIADB_ROOT_PASSWORD=change-me-first-start-only
# Proxy sidecar cap (default 32m): MARIADB_PROXY_MEM_LIMIT=32m
# MARIADB_MEM_LIMIT above: ~2x innodb_buffer_pool_size / shared_buffers. Raise buffer pool and limit together (docs/memory.md).
