APP_ROOT=/app
TZ=Asia/Jakarta
POSTGRES_TAG=17-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# shared_buffers=512MB
POSTGRES_MEM_LIMIT=2g
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
# Proxy sidecar cap (default 32m): POSTGRES_PROXY_MEM_LIMIT=32m
# POSTGRES_MEM_LIMIT above: ~2x innodb_buffer_pool_size / shared_buffers. Raise buffer pool and limit together (docs/memory.md).
