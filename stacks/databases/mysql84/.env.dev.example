APP_ROOT=/app
TZ=Asia/Jakarta
MYSQL84_TAG=8.4
MYSQL84_CNF=low-memory
MYSQL84_BIND=127.0.0.1
MYSQL84_PORT=3307
MYSQL84_ALLOW_EMPTY=yes
