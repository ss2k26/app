APP_ROOT=/app
TZ=Asia/Jakarta
MYSQL84_TAG=8.4
MYSQL84_CNF=production
# production.cnf: 1G buffer pool
MYSQL84_MEM_LIMIT=2g
MYSQL84_BIND=127.0.0.1
MYSQL84_PORT=3307
MYSQL84_ROOT_PASSWORD=change-me-first-start-only
# Proxy sidecar cap (default 32m): MYSQL84_PROXY_MEM_LIMIT=32m
# MYSQL84_MEM_LIMIT above: ~2x innodb_buffer_pool_size / shared_buffers. Raise buffer pool and limit together (docs/memory.md).
