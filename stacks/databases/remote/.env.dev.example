# Remote databases for DEV. `bin/platform init dev` copies this to .env.
APP_ROOT=/app

# What to start (comma separated): windows,mysql56,mysql84,mariadb,postgres
#   windows  = MySQL installed on the Windows 10 host (see "Windows host" below)  <- typical dev setup
#   others   = databases of a VPS (see "VPS" below)
COMPOSE_PROFILES=windows

# ============================ Windows host (profile: windows) ============================
# Apps use  DB_HOST=windows-mysql  DB_PORT=3309  user root  (or the 127.0.0.1 sidecar, see docs/remote-db.md)
# direct : plain TCP. WINDOWS_PORT=13306 -> windows\6-wsl-mysql-bridge-start.bat (MySQL then sees 127.0.0.1)
#                     WINDOWS_PORT=3306  -> straight to MySQL (MySQL sees the WSL IP; root@localhost is refused)
# ssh    : through Windows OpenSSH Server, WINDOWS_PORT=3306 (MySQL sees 127.0.0.1). Needs key in data/ssh/.
WINDOWS_MODE=direct
WINDOWS_HOST=windows
WINDOWS_PORT=13306
WINDOWS_LOCAL_PORT=3309
WINDOWS_ALIAS=windows-mysql
# ssh mode only
WINDOWS_SSH_USER=
WINDOWS_SSH_PORT=22
WINDOWS_SSH_KEY=id_ed25519

# ============================ VPS databases (profiles: mysql56 ...) ============================

# ssh    = tunnel through SSH (VPS DB port can stay on 127.0.0.1)  <- recommended
# direct = plain TCP to REMOTE_HOST:<port>  (VPS must publish the DB port, *_BIND=0.0.0.0; traffic is NOT encrypted)
REMOTE_MODE=ssh
REMOTE_HOST=vps.example.com

# --- ssh mode ---
REMOTE_SSH_USER=ubuntu
REMOTE_SSH_PORT=22
# private key file inside /app/data/ssh/  (generate: ssh-keygen -t ed25519 -f data/ssh/id_ed25519)
REMOTE_SSH_KEY=id_ed25519
# the DB port as seen from the VPS itself (127.0.0.1 when the VPS binds the DB to loopback)
REMOTE_SSH_TARGET_HOST=127.0.0.1

# Ports published by the databases ON THE VPS (defaults of stacks/databases/*)
REMOTE_MYSQL56_PORT=3306
REMOTE_MYSQL84_PORT=3307
REMOTE_MARIADB_PORT=3308
REMOTE_POSTGRES_PORT=5432

# Ports on THIS PC (127.0.0.1). Must not clash with a local database stack that is running.
REMOTE_BIND=127.0.0.1
REMOTE_MYSQL56_LOCAL_PORT=3306
REMOTE_MYSQL84_LOCAL_PORT=3307
REMOTE_MARIADB_LOCAL_PORT=3308
REMOTE_POSTGRES_LOCAL_PORT=5432

# Docker alias of each forwarder on the `data` network. Set to the normal name (mysql56 ...) to make
# your apps use the remote DB with an unchanged DB_HOST - then stop the local stack of that engine.
REMOTE_MYSQL56_ALIAS=remote-mysql56
REMOTE_MYSQL84_ALIAS=remote-mysql84
REMOTE_MARIADB_ALIAS=remote-mariadb
REMOTE_POSTGRES_ALIAS=remote-postgres
