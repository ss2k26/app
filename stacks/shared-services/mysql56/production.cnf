[mysqld]
max_connections=50
thread_cache_size=8
table_open_cache=256

innodb_buffer_pool_size=1G
innodb_log_file_size=256M
innodb_log_buffer_size=16M

query_cache_type=0
query_cache_size=0

tmp_table_size=16M
max_heap_table_size=16M
sort_buffer_size=1M
join_buffer_size=256K
read_buffer_size=256K
read_rnd_buffer_size=512K
thread_stack=256K
