# Traefik - PROD (VPS). Copied to .env by `bin/platform init prod`.
APP_ROOT=/app
TRAEFIK_TAG=v3.7
# --- Let's Encrypt (domains) ---
ACME_EMAIL=you@yourdomain.com
# Use the staging CA while testing to avoid rate limits:
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# --- IP:port with private-CA certificate ---
# Put the VPS public IP (comma separate to add more). Leave localhost for local checks.
CERT_NAMES=203.0.113.10,localhost,127.0.0.1
# Open the IP:port pool (8443-8450) to the internet. 127.0.0.1 = only reachable via SSH tunnel.
TRAEFIK_IP_BIND=0.0.0.0
TRAEFIK_LOG_LEVEL=INFO
