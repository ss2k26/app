APP_NAME=panglima-kediri
APP_ROOT=/app
PHP_VERSION=5.6
TZ=Asia/Jakarta
CLIENT_MAX_BODY_SIZE=64m
# Long-running PHP requests: nginx waits FASTCGI_READ_TIMEOUT, PHP stops at the two PHP_* limits (seconds).
# Keep the three equal. Defaults: 300. Example for jobs up to 10 minutes:
# FASTCGI_READ_TIMEOUT=600s
# FASTCGI_SEND_TIMEOUT=600s
# PHP_MAX_EXECUTION_TIME=600
# PHP_REQUEST_TERMINATE_TIMEOUT=600
# --- A) public domain + Let's Encrypt (delete these 3 lines to disable) ---
APP_HOST_PROD=panglima-kediri.yourdomain.com
# APP_HOST_PROD_ALT=www.panglima-kediri.yourdomain.com
ACME_RESOLVER=le
# --- B) server IP + custom port, private-CA cert (delete these 2 lines to disable) ---
APP_IP_HOST=203.0.113.10
APP_IP_EP=ip-8445
# Call other apps from PHP over Docker (no DNS/TLS): every app answers at http://<app>.app (e.g. http://bengkel.app).
# Enable in the CALLING app (uncomment), keep Host header if the target builds URLs from it:
# PHP_APPS_NETWORK=apps
# BENGKEL_API_URL=http://bengkel.app
# Memory (container caps; defaults apply when unset, 0 = unlimited). Rule of thumb:
#   PHP_MEM_LIMIT >= PHP_FPM_MAX_CHILDREN x PHP_MEMORY_LIMIT + ~100m     (defaults: 3 x 128M -> 512m)
# Busy/heavy app example (report/export jobs):
# PHP_MEMORY_LIMIT=256M
# PHP_FPM_MAX_CHILDREN=8
# PHP_MEM_LIMIT=2300m
# WEB_MEM_LIMIT=128m
# PHP worker mode. ondemand (default): workers start with the first request and exit after
# PHP_FPM_PROCESS_IDLE_TIMEOUT, so an idle app holds almost no worker memory. Best with many apps per server.
# dynamic/static keep workers warm (a little faster after idle; uses memory all the time).
# PHP_FPM_PM=ondemand
# PHP_FPM_MAX_CHILDREN=3
# PHP_FPM_PROCESS_IDLE_TIMEOUT=10s
