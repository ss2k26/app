APP_NAME=bengkel
APP_ROOT=/app
PHP_VERSION=7.2
TZ=Asia/Jakarta
CLIENT_MAX_BODY_SIZE=64m
# Long-running PHP requests: nginx waits FASTCGI_READ_TIMEOUT, PHP stops at the two PHP_* limits (seconds).
# Keep the three equal. Defaults: 300. Example for jobs up to 10 minutes:
# FASTCGI_READ_TIMEOUT=600s
# FASTCGI_SEND_TIMEOUT=600s
# PHP_MAX_EXECUTION_TIME=600
# PHP_REQUEST_TERMINATE_TIMEOUT=600
# dev: https://bengkel.mysite.test
APP_HOST_DEV=bengkel.mysite.test
# Database on the Windows 10 host (stack "remote", profile windows): DB_HOST=windows-mysql DB_PORT=3309.
# Code with 127.0.0.1:3306 hard-coded? enable the in-app proxy:
# COMPOSE_PROFILES=localdb
# DB_UPSTREAM_HOST=windows-mysql
# DB_UPSTREAM_PORT=3309
